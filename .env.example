# Copy to .env at the repo root. The backend loads this on boot.
# These are PROVIDER (server-side) keys — never expose them to the browser.

# Anthropic Claude — https://platform.claude.com  (Console → API keys)
ANTHROPIC_API_KEY=sk...

# Optional — enable the other providers the same way:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...